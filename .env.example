# ==============================================
# Trust-Tracker Environment Configuration
# ==============================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Self-Hosted / Docker / Coolify)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trust_tracker
DATABASE_SSL=false

# Authentication
JWT_SECRET=your_super_secret_random_jwt_key_min_32_chars

# Optional AI Features (Google Gemini for Diary & Receipt parsing)
GEMINI_API_KEY=

# Client (Vite)
VITE_API_URL=/api
